# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
managed/
.cache/
.turbo/

# Local configuration and secrets
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!*.env.example
!*.env.*.example
*.local

# Runtime state and generated evidence are private until explicitly reviewed.
**/.state/
**/.cico-state/
**/postgres-data/
*.db
*.sqlite
*.sqlite3
deploy/passport-v2/*.manifest.json
deploy/passport-v2/*.transcript.json
deploy/passport-v2/*.transcript.md

# Temporary smoke-test material
tmp/
coverage/
*.log
playwright-report/
test-results/
.codex-patches/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/

# Compact/compiler artifacts that should be regenerated from source
*.zkir
*.key
*.pk
*.vk
contracts/**/managed/
contracts/**/dist/
api/src/generated/credential-registry-v1/
api/src/generated/referendum-v2/
ui/public/managed/credential-registry-v1/
ui/public/managed/referendum-v2/
# Midnight's public parameter files, fetched and verified by `npm run zk:params`.
ui/public/zk-params/

# Third-party agent skills and local agent state: tooling, not project code.
.agents/
.claude/
skills-lock.json

# Static deployment archives are large build outputs, reproducible from a tag.
deploy/hostinger/artifacts/*.zip
