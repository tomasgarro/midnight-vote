# Copy to .env.relayer.local. Inject only into the relayer process.

RELAYER_SEED=REPLACE_64_HEX_RELAYER_SEED
RELAYER_NETWORK_ID=preview
RELAYER_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
RELAYER_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
RELAYER_NODE_URL=wss://rpc.preview.midnight.network
RELAYER_PROOF_SERVER_URL=http://relayer-proof:6300
RELAYER_HOST=0.0.0.0
RELAYER_PORT=8790
RELAYER_ALLOWED_ORIGINS=https://REPLACE_UI_DOMAIN

# This value must equal CICO_ACTION_CAPABILITY_SECRET in .env.cico.local.
RELAYER_V2_AUTH_TOKEN=
RELAYER_V2_CAPABILITY_SECRET=REPLACE_64_HEX_ACTION_CAPABILITY_SECRET
RELAYER_V2_ALLOWED_NETWORKS=preview
RELAYER_V2_ALLOWED_CONTRACTS=REPLACE_REFERENDUM_CONTRACT_ADDRESS
# castVote seals an answer; revealVote lets the same device count it later (ADR-009).
RELAYER_V2_ALLOWED_CIRCUITS=castVote,revealVote
# Random wait, in milliseconds, before an accepted action is submitted. It
# makes it harder to match a network address to a transaction by time alone.
# 0 submits at once; the maximum is 60000.
RELAYER_V2_SUBMIT_DELAY_MAX_MS=20000
RELAYER_V2_DATABASE_URL=postgres://REPLACE_RELAYER_DB_USER:REPLACE_RELAYER_DB_PASSWORD@relayer-postgres:5432/REPLACE_RELAYER_DB_NAME
RELAYER_V2_JOB_STORE_PATH=/var/lib/relayer/state/v2-actions.json
RELAYER_EXPLORER_BASE_URL=https://explorer.preview.midnight.network/tx

# Compatibility endpoints are never part of the public pilot surface.
RELAYER_LEGACY_API_ENABLED=false
