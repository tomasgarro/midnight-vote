# Copy to .env.cico.local and set values in the operator secret store.
# This file is injected only into the CICO process; do not merge it with the
# relayer or Rarimo environment files.

CICO_NETWORK=preview
CICO_HOST=0.0.0.0
CICO_PORT=8791
CICO_ALLOWED_ORIGINS=https://REPLACE_UI_DOMAIN
CICO_STATE_DIRECTORY=/var/lib/cico-passport

# The CICO process reaches the verifier on a dedicated, non-public network.
CICO_RARIMO_BASE_URL=http://rarimo-verificator:8000
CICO_RARIMO_PRIVATE_HEADERS_JSON={}
CICO_RARIMO_PROOF_PARAMS_ORIGINS=https://REPLACE_RARIMO_DOMAIN
CICO_RARIMO_PROOF_REQUEST_BASE_URL=https://app.rarime.com/external

CICO_ISSUER_ID=REPLACE_ISSUER_ID
CICO_ISSUER_ID_HEX=REPLACE_ISSUER_ID_HEX
CICO_CREDENTIAL_EPOCH=REPLACE_CREDENTIAL_EPOCH
CICO_REGISTRY_CONTRACT_ADDRESS=REPLACE_REGISTRY_CONTRACT_ADDRESS
CICO_REGISTRY_ID_HEX=REPLACE_REGISTRY_ID_HEX

# Independent 32-byte values. Never reuse the relayer seed or another role.
CICO_ISSUER_WALLET_SEED=REPLACE_64_HEX_ISSUER_WALLET_SEED
CICO_ISSUER_ROLE_SECRET=REPLACE_64_HEX_ISSUER_ROLE_SECRET
CICO_ROOT_PUBLISHER_SECRET_HEX=REPLACE_64_HEX_ROOT_PUBLISHER_SECRET

CICO_ZK_CONFIG_PATH=/app/contracts/credential-registry-v1/managed/credential-registry-v1
CICO_REFERENDUM_ZK_CONFIG_PATH=/app/contracts/referendum-v2/managed/referendum-v2
CICO_PROOF_SERVER_URL=http://cico-proof:6300
CICO_APPROVED_PROOF_ORIGINS=
CICO_NODE_URL=wss://rpc.preview.midnight.network
CICO_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
CICO_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
CICO_EXPLORER_BASE_URL=https://explorer.preview.midnight.network/tx

CICO_CREDENTIAL_TTL_MS=86400000
CICO_MAXIMUM_ISSUANCE_DELAY_MS=600000

# Must equal RELAYER_V2_CAPABILITY_SECRET in .env.relayer.local, but must not
# equal either issuer secret above.
CICO_ACTION_CAPABILITY_SECRET=REPLACE_64_HEX_ACTION_CAPABILITY_SECRET
CICO_ACTION_CAPABILITY_TTL_SECONDS=120
CICO_ACTION_ALLOWED_NETWORKS=preview
CICO_ACTION_ALLOWED_CONTRACTS=REPLACE_REFERENDUM_CONTRACT_ADDRESS
CICO_ACTION_ALLOWED_CIRCUITS=castVote,revealVote

# Leave empty until a reviewed referendum manifest is available. If populated,
# this must be a complete JSON array, not a partially filled entry.
CICO_REFERENDA_JSON=
CICO_ROOT_PUBLISH_MIN_BATCH=16
CICO_ROOT_PUBLISH_MAX_WAIT_MS=900000
CICO_ROOT_PUBLISH_INTERVAL_MS=60000
