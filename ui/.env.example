# demo keeps the citizen flow local and does not require a wallet, a relayer,
# a contract, or a proof server. It may save an explicitly simulated receipt
# in the encrypted Passport-scoped local vault after demo completion.
VITE_APP_MODE=demo
# Optional comma-separated Midnight wallet connector RDNS preference.
# Leave empty until the preferred wallet vendor confirms its RDNS identifier.
# VITE_MIDNIGHT_PREFERRED_WALLET_RDNS=

# Local chain prototype: use Lace's Undeployed network with the three Docker
# services from docker-compose.undeployed.yml. Passport remains a synthetic
# local walkthrough until a Passport provider supports this network.
# VITE_APP_MODE=undeployed
# VITE_MIDNIGHT_NETWORK=undeployed
# VITE_MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
# VITE_MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws

VITE_MIDNIGHT_NETWORK=preview

# Written by `npm run deploy:preview`.
VITE_MIDNIGHT_CONTRACT_ADDRESS=

# --- Sponsored relayer (the default civic path) -----------------------------
# The relayer pays the fee and submits a transaction that was already proved.
# It never builds a proof and never sees an answer. Leave empty to use the
# DApp Connector (Lace) for fees as well.
VITE_RELAYER_URL=
# Local development only.
# VITE_RELAYER_URL=http://localhost:8790

# --- Cleisthenes inside the consultation page --------------------------------
# Which consultation reads which body of evidence. Both values are public.
# A consultation without a source shows no brief. Requests carry no pass, no
# Passport session and no answer, and are sent without cookies.
# VITE_ASSISTANT_API_URL=/Switzerland/api
# VITE_ASSISTANT_SOURCES_JSON={"ch-2026-11-29-ahv":{"objectId":"6900"}}

# --- Proving on the device, without a wallet (ADR-011) ----------------------
# A browser without Lace builds the proof itself with Midnight's WASM prover.
# This is the default. It is slow (minutes) and sends the answer to no server.
# Run `npm run zk:params` before building, so the public parameter files are
# served from this origin. Set VITE_DEVICE_PROVING=off to switch the mode off.
# VITE_DEVICE_PROVING=off
# VITE_DEVICE_PARAMS_URL=/zk-params

# --- Hosted proving for browsers without a wallet (ADR-010) -----------------
# With Lace connected, Lace builds the proof on the device and this is unused.
# Without a wallet a person may choose this server instead of their own device.
#
# PRIVACY: the proving server sees the witness: the pass secret, the answer and
# its salt. The app shows that to the person and sends nothing before they
# accept. Point this only at a proving server you operate under the rules in
# docs/adr/ADR-010-disclosed-hosted-proving.md. HTTPS is required; plain HTTP
# is accepted for localhost. Leave empty to keep the mode switched off.
VITE_HOSTED_PROOF_SERVER_URL=
# VITE_HOSTED_PROOF_SERVER_URL=http://localhost:6300

VITE_MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Passport profile bridge and canonical explorer base.
VITE_PASSPORT_ORIGIN=https://midnightpassport.com
# Public Passport account network. This does not change the consultation contract network.
VITE_PASSPORT_NETWORK=stagenet
# Optional CICO backend for the narrow Rarimo verified-evidence and Midnight
# credential-issuance boundaries. Ballot choice and Compact witnesses stay in
# the browser. Leave empty to stop honestly after Passport connection.
VITE_PASSPORT_V2_API_URL=
# Required together with VITE_PASSPORT_V2_API_URL. All values are public
# deployment data; never put issuer/organizer secrets in VITE_* variables.
VITE_CICO_ISSUER_ID=cico-rarimo-preview
VITE_CICO_CREDENTIAL_EPOCH=1
VITE_CICO_CREDENTIAL_TTL_MS=86400000
VITE_RARIMO_UNIQUENESS_TIMESTAMP_UPPER_BOUND=
VITE_CICO_REGISTRY_ADDRESS=
VITE_CICO_REGISTRY_ID_HEX=
VITE_CICO_ISSUER_ID_HEX=
VITE_CICO_FROZEN_ROOT_FIELD=
# JSON array of {referendumId,contractAddress,title,question,eventIdHex,
# organizerKeyHex,countryPolicy:null|"032",minimumAssurance,requireAdult,
# validityReference}. title and question are required governance copy.
VITE_CICO_REFERENDA_JSON=[]
VITE_MIDNIGHT_EXPLORER_BASE_URL=https://explorer.preview.midnight.network/tx
