# Relayer wallet seed: 64 hex characters (32 bytes).
#
# This key pays the network fee for every vote. Generate it yourself and keep
# it out of git — relayer/.env is gitignored. Never paste it into a chat, an
# issue, or a commit.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then fund the resulting address with Preview NIGHT and register it for DUST:
#
#   npm run address --workspace midnight-referendum-relayer
#
RELAYER_SEED=

# Midnight Preview infrastructure. Defaults match the public Preview services.
RELAYER_NETWORK_ID=preview
RELAYER_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
RELAYER_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
RELAYER_NODE_URL=wss://rpc.preview.midnight.network

# The relayer proves its own balancing transaction here.
RELAYER_PROOF_SERVER_URL=http://localhost:6300

# Loopback only. Exposing this without auth lets anyone spend the relayer's DUST.
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8790
RELAYER_ALLOWED_ORIGINS=http://localhost:4173

# Walletless v2 is fail-closed until the trusted issuer configures a
# short-lived one-time capability secret and explicit action policy. The
# bearer token is optional additive auth for service-to-service callers and
# must never be shipped to a browser. Production should set PostgreSQL; the
# JSON path is only a local recovery/test adapter.
RELAYER_V2_AUTH_TOKEN=
RELAYER_V2_CAPABILITY_SECRET=
RELAYER_V2_ALLOWED_NETWORKS=preview
RELAYER_V2_ALLOWED_CONTRACTS=
RELAYER_V2_ALLOWED_CIRCUITS=castVote
RELAYER_V2_DATABASE_URL=
RELAYER_V2_JOB_STORE_PATH=.state/v2-actions.json
# Keeps the wallet's synchronized state between starts, so a restart does not
# replay the chain (about 85 minutes on Preview). The file holds no key. Leave
# empty to keep nothing.
RELAYER_WALLET_STATE_PATH=.state/wallet-state.json
RELAYER_EXPLORER_BASE_URL=

# Compatibility-only v1 transaction routes. Keep false for every active v2
# environment; enabling this exposes unauthenticated /balance and /submit.
RELAYER_LEGACY_API_ENABLED=false
